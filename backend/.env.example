# Required: Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: AI Model name (defaults to openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Additional allowed origins for CORS (comma-separated)
# Note: localhost and *.vercel.app are automatically permitted by default
# ALLOWED_ORIGINS=https://my-custom-domain.com

# Optional: Port (automatically set by Render in production)
# PORT=8000
